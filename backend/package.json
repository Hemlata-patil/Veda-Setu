{
  "name": "veda-setu-backend",
  "version": "1.0.0",
  "description": "Traditional Node.js + Express + TypeScript backend for VEDA SETU",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "test": "tsx scripts/test-traditional-auth.ts",
    "test:module1": "tsx scripts/test-traditional-auth.ts",
    "test:module2": "tsx scripts/test-module2-competencies.ts",
    "test:module3": "tsx scripts/test-module3-opportunities.ts",
    "test:module4": "tsx scripts/test-module4-faculty-institution.ts",
    "test:module5": "tsx scripts/test-module5-mentorship-collaboration.ts",
    "test:module6": "tsx scripts/test-module6-placements-portfolio.ts",
    "test:all": "tsx scripts/test-traditional-auth.ts && tsx scripts/test-module2-competencies.ts && tsx scripts/test-module3-opportunities.ts && tsx scripts/test-module4-faculty-institution.ts && tsx scripts/test-module5-mentorship-collaboration.ts && tsx scripts/test-module6-placements-portfolio.ts",
    "migrate": "tsx src/db/migrate.ts"
  },
  "keywords": [
    "veda-setu",
    "express",
    "typescript",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/multer": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
